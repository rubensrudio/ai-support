# Atlas configuration. Copy to `.env` and fill the secrets. Never commit `.env`.

# App and database
ATLAS_APP_ENV=local
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
ATLAS_LOG_LEVEL=INFO

# LLM providers (secrets)
# anthropic | fake | claude_cli | codex_cli (the last two use your logged-in CLI subscription,
# local manual testing only; no API key, cost is not measured)
ATLAS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ATLAS_PRIMARY_MODEL=
ATLAS_SECONDARY_MODEL=
ATLAS_GUARDRAIL_MODEL=
ATLAS_JUDGE_MODEL=
ATLAS_EMBEDDING_PROVIDER=openai
ATLAS_EMBEDDING_MODEL=text-embedding-3-small
ATLAS_EMBEDDING_DIMENSIONS=1536
ATLAS_PRICING_FILE=config/pricing.json

# Resilience
ATLAS_LLM_TIMEOUT_SECONDS=30
ATLAS_LLM_MAX_RETRIES=3
ATLAS_RETRY_BASE_DELAY_SECONDS=0.5
ATLAS_BREAKER_FAILURE_THRESHOLD=5
ATLAS_BREAKER_RESET_SECONDS=30
CHAOS_RATE=0

# Conversation
ATLAS_CONTEXT_BUDGET_TOKENS=8000
ATLAS_HISTORY_MODE=summarized
ATLAS_MAX_MESSAGE_CHARS=4000

# Retrieval
# none | fulltext | vector_bruteforce | vector_hnsw | hybrid (default: full-text + HNSW fused
# with RRF). Vector modes and hybrid embed the question with ATLAS_EMBEDDING_PROVIDER.
ATLAS_RETRIEVAL_MODE=hybrid
ATLAS_RETRIEVAL_TOP_K=5
ATLAS_HNSW_M=16
ATLAS_HNSW_EF_CONSTRUCTION=64
ATLAS_HNSW_EF_SEARCH=40
ATLAS_RRF_K=60

# Agent
ATLAS_AGENT_TOOLS_ENABLED=true
ATLAS_AGENT_MAX_STEPS=8
ATLAS_AGENT_MAX_COST_USD=0.25
ATLAS_CONFIRMATION_TTL_MINUTES=15

# Triage
ATLAS_TRIAGE_MODE=schema
ATLAS_TRIAGE_MAX_REPAIRS=2

# Guardrails and prompt cache
ATLAS_GUARDRAILS_ENABLED=true
ATLAS_INGEST_INJECTION_SCAN=true
ATLAS_PROMPT_LAYOUT=cache_ordered

# Auth and demo personas
ATLAS_SESSION_TTL_HOURS=24
ATLAS_COOKIE_SECURE=false
ATLAS_PERSONA_PASSWORD=atlas-demo
# Secret; empty disables operator access to triage
ATLAS_OPERATOR_API_KEY=

# Public demo limits and maintenance
ATLAS_RATE_LIMIT_PER_HOUR=20
ATLAS_DAILY_SPEND_CAP_USD=2.00
ATLAS_RETENTION_DAYS=7
ATLAS_MAINTENANCE_ENABLED=false
ATLAS_MAINTENANCE_INTERVAL_SECONDS=300

# Observability (keys are secrets)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Screen QA credentials
ATLAS_QA_USERNAME=
ATLAS_QA_PASSWORD=

# Subscription CLI providers (ATLAS_LLM_PROVIDER=claude_cli|codex_cli)
# ATLAS_PRIMARY_MODEL is passed to the CLI as-is: leave it empty to use the CLI default, or set a
# model that CLI accepts (a Claude model for claude_cli, an OpenAI model for codex_cli).
ATLAS_CLAUDE_CLI_PATH=claude
ATLAS_CODEX_CLI_PATH=codex
ATLAS_CLI_TIMEOUT_SECONDS=120
